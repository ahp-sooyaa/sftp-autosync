{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "SFTP: Push Current File",
      "type": "shell",
      "command": "sftp-autosync push ${relativeFile}",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "SFTP: Push Git Changed",
      "type": "shell",
      "command": "sftp-autosync push --changed",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "SFTP: Push Project",
      "type": "shell",
      "command": "sftp-autosync push",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}
